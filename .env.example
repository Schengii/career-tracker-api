# Vorlage für Umgebungsvariablen. Kopieren nach .env (wird von .gitignore ausgeschlossen);
# echte Werte niemals committen.
#
# Spring Boot liest .env nicht selbst. Laden in der Shell:
#   set -a && . ./.env && set +a && mvn spring-boot:run
# oder mit Docker:
#   docker run --env-file .env -p 8080:8080 career-tracker-api

# JWT-Signaturschlüssel, mindestens 32 Bytes, zufällig (z. B. `openssl rand -base64 48`).
# Ohne Wert wird bei jedem Start ein zufälliger Schlüssel erzeugt, Tokens verfallen dann nach einem Neustart.
JWT_SECRET=

# Nur für das Profil "postgres" (-Dspring-boot.run.profiles=postgres)
DB_URL=jdbc:postgresql://localhost:5432/careertracker
DB_USER=postgres
DB_PASSWORD=
